# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://verifyai:changeme@localhost:5432/verifyai_db

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=../storage/uploads
PROCESSED_DIR=../storage/processed
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500

# ── OCR ───────────────────────────────────────────────────────
TESSERACT_CMD=tesseract
# Windows example: TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://aicte-verify-ai-beta.vercel.app

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
